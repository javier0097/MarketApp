<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Lint rules block only on push (.githooks/pre-push passes -p:Lint=true), not on every build -->
  <PropertyGroup Condition="'$(Lint)' == 'true'">
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- CS0162 is a compiler warning, checked on every build: as an error in .editorconfig it would block normal builds too -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0162</WarningsAsErrors>
    <!-- IDE0005 is only reported on build with XML docs on; CS1591 (missing doc comments) is its side effect -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <!-- Git never activates hooks from a clone on its own; any build does it here -->
  <Target Name="ConfigureGitHooks" BeforeTargets="Build">
    <Exec Command="git config core.hooksPath .githooks" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Condition="'$(_IsPublishing)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" Condition="!Exists('$(MSBuildProjectDirectory)/../../frontend/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" />
    <!-- The wwwroot file list was taken before this build: drop files Vite deleted and add the new ones -->
    <ItemGroup>
      <Content Remove="@(Content)" Condition="!Exists('%(FullPath)')" />
      <Content Include="wwwroot/**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
