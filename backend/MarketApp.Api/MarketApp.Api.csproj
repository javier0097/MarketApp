<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Visual Studio restores without _IsPublishing, so the win-x64 packages the publish needs must always be restored -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <!-- Git never activates hooks from a clone on its own; any build does it here -->
  <Target Name="ConfigureGitHooks" BeforeTargets="Build">
    <Exec Command="git config core.hooksPath .githooks" ContinueOnError="true" StandardOutputImportance="low" />
  </Target>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Condition="'$(_IsPublishing)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" Condition="!Exists('$(MSBuildProjectDirectory)/../../frontend/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)/../../frontend" />
    <!-- The wwwroot file list was taken before this build: drop files Vite deleted and add the new ones -->
    <ItemGroup>
      <Content Remove="@(Content)" Condition="!Exists('%(FullPath)')" />
      <Content Include="wwwroot/**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
