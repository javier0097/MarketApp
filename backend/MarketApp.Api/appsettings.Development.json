{
  "Serilog": {
    "WriteTo": {
      "File": {
        "Args": {
          "path": "logs/marketapp-.log"
        }
      },
      "Console": {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} [{Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  },
  "ConnectionStrings": {
    "MarketApp": "Data Source=marketapp.db"
  }
}
