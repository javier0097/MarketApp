{
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": {
      "File": {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\MarketApp\\logs\\marketapp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": null,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {TraceId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MarketApp": "Data Source=C:\\ProgramData\\MarketApp\\marketapp.db"
  },
  "Urls": "http://localhost:5120"
}
